<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>mozsc</title>
    <link rel="stylesheet" href="/index.css">
</head>
<body>
    <h1 class="title">
        Forum !! mozsc
    </h1>
    <div class="flex flex-row margin-bottom">
        <div class="flex-1"></div>
        <p>Logged in as <%- session.username %></p>
        <% if (session.is_admin) { %>
            <div class="chip chip-red">ADMIN</div>
        <% } %>
    </div>
    
    <form action="/" method="post">
        <div class="new-post">
            <h3 class="title">New Post</h3>

            <label for="new-post-title">Title</label>
            <input type="text" name="title" id="new-post-title">
            
            <label for="new-post-body">Body</label>
            <textarea name="body" id="new-post-body" rows="5" cols="33"></textarea>

            <button type="submit">Create Post</button>
        </div>
    </form>

    <div id="posts" class="posts">
        <% for(const post of posts){ %>
            <div id="post-<%- post.id %>" class="post">
                <h2>
                    <a href="/posts/<%- post.id %>">#<%= post.id %> <%= post.title %></a>
                </h2>

                <p>
                    <a href="/posts/<%- post.id %>">
                        <% if(post.body.length > 75) { %>
                            <%= post.body.slice(0, 75) %>...
                        <% } else { %>
                            <%= post.body %>
                        <% } %>
                    </a>
                </p>

                <h5>
                    Author: <%- post.author %>, Date: <%- new TZDate(post.created_at, timezone).toLocaleString("fr-CH") %>
                </h5>
            </div>
        <% } %>
    </div>
</body>
</html>